{
  "name": "interstice",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "npm-run-all test:app test:pipeline",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "npm-run-all lint:app lint:pipeline lint:e2e",
    "lint:fix": "eslint src test package.json --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "test:app": "jest --colors",
    "test:pipeline": "vitest run",
    "lint:app": "eslint src test package.json --ext .ts,.tsx",
    "lint:pipeline": "tsc --noEmit -p pipeline/tsconfig.json",
    "pipeline": "tsx pipeline/run.ts",
    "build:e2e": "INTERSTICE_E2E=http://localhost:8099 react-native build-vega --build-type Release",
    "e2e:fixtures": "tsx e2e/fixtures.ts",
    "e2e:release": "E2E_CAPTURE=${E2E_CAPTURE:-grpc:node_modules/@fortemate/vega-vvd-driver/dist/bin.js} tsx e2e/run.ts --suite release",
    "e2e:variant": "E2E_CAPTURE=${E2E_CAPTURE:-grpc:node_modules/@fortemate/vega-vvd-driver/dist/bin.js} tsx e2e/run.ts --suite variant",
    "e2e": "npm-run-all e2e:release e2e:variant",
    "e2e:selftest": "vitest run e2e/__tests__/selftest.test.ts",
    "e2e:report": "tsx e2e/report/build.ts",
    "e2e:publish": "tsx e2e/report/publish.ts",
    "lint:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "viz": "npm-run-all viz:timeline viz:split",
    "viz:timeline": "tsx tools/viz/cli.ts timeline",
    "viz:split": "tsx tools/viz/cli.ts split",
    "viz:check": "tsc --noEmit -p tools/viz/tsconfig.json"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-polly": "^3.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-tv-audio-description": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@fortemate/vega-vvd-driver": "0.2.2",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.0.0",
    "typescript": "5.8.3",
    "vitest": "^5.0.1"
  },
  "kepler": {
    "projectType": "application",
    "appName": "interstice",
    "targets": [
      "tv"
    ]
  }
}
