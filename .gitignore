# demo video asset — downloaded, never committed (see README)
# derived media — regenerate per README, never committed
# eslint plugin state
# machine-local agent config (symlinked skills)
# vega build output
# Source media lives in media/, NOT in assets/. The Vega build copies the whole
# project-root assets/ directory into the package verbatim, so a 117 MB film
# left there ships to the device — see FRICTION-LOG 2026-09-25.
media/*.mkv
media/*.mov
media/*.mp4
build
buildinfo.json
CMakeUserPresets.json
dist
generated/
node_modules
node_modules/
npm-debug.log
out/
src/assets/*.mp4
# Generated by pipeline/segment.ts from src/assets/clip.mp4 — derived artefacts,
# rebuilt by the pipeline rather than committed.
src/assets/seg/
# but the generated module IS the app's entry point into them, so its SHAPE
# matters to a reader even though its content is derived
!src/assets/seg/segments.ts
